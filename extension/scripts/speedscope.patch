diff --git a/src/vscode.ts b/src/vscode.ts
new file mode 100644
index 0000000..a628568
--- /dev/null
+++ b/src/vscode.ts
@@ -0,0 +1,74 @@
+// Glue for running speedscope inside a VS Code webview (oprof extension).
+//
+// Host -> webview:  {type: 'load', name: string, data: string, highlight?: {db: number[], module: number[]}}
+// Webview -> host:  {type: 'ready'}
+//                   {type: 'loaded'}
+//                   {type: 'error', message: string}
+//                   {type: 'openFrame' | 'frameDblClick', name, file, line, col, key, alt}
+
+import {Frame} from './lib/profile'
+
+interface VSCodeApi {
+  postMessage(message: any): void
+}
+
+declare const acquireVsCodeApi: (() => VSCodeApi) | undefined
+
+// acquireVsCodeApi() may only be called once per webview.
+const api: VSCodeApi | null =
+  typeof acquireVsCodeApi === 'function' ? (acquireVsCodeApi as () => VSCodeApi)() : null
+
+export const isVSCode = api != null
+
+export function postToHost(message: any) {
+  if (api) api.postMessage(message)
+}
+
+// oprof: frames drawn in their own colour, by key (their index in the file's frames): code
+// stored in the database (server actions, crons, Studio computes), and custom modules' code.
+export const highlight = {db: new Set<number | string>(), module: new Set<number | string>()}
+
+export function setHighlight(h: {db?: (number | string)[]; module?: (number | string)[]} | undefined) {
+  highlight.db = new Set(h && h.db ? h.db : [])
+  highlight.module = new Set(h && h.module ? h.module : [])
+}
+
+// The colour buckets: 0-253 for the others, 254 custom modules, 255 the database's code.
+export const MODULE_BUCKET = 254
+export const DB_BUCKET = 255
+
+export type FrameMessageType = 'openFrame' | 'frameDblClick'
+
+export function postFrame(type: FrameMessageType, frame: Frame, alt: boolean) {
+  postToHost({
+    type,
+    name: frame.name,
+    file: frame.file,
+    line: frame.line,
+    col: frame.col,
+    key: frame.key,
+    alt,
+  })
+}
+
+// Theme: VS Code sets vscode-light / vscode-dark / vscode-high-contrast
+// (and vscode-high-contrast-light) on <body>. Anything that isn't explicitly
+// light is treated as dark.
+export function vscodeBodyPrefersDark(): boolean {
+  const cl = document.body ? document.body.classList : null
+  if (!cl) return true
+  if (cl.contains('vscode-light') || cl.contains('vscode-high-contrast-light')) return false
+  return true
+}
+
+export function watchVSCodeTheme(onChange: (dark: boolean) => void) {
+  if (!isVSCode || !document.body || typeof MutationObserver === 'undefined') return
+  let last = vscodeBodyPrefersDark()
+  new MutationObserver(() => {
+    const dark = vscodeBodyPrefersDark()
+    if (dark !== last) {
+      last = dark
+      onChange(dark)
+    }
+  }).observe(document.body, {attributes: true, attributeFilter: ['class']})
+}
