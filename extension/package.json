    "customEditors": [
      {
        "viewType": "oprof.speedscope",
        "displayName": "vscodetool profile viewer",
        "selector": [
          {
            "filenamePattern": "*.speedscope.json"
          },
          {
            "filenamePattern": "*.oprof.json"
          }
        ],
        "priority": "option"
      }
    ],
    "debuggers": [
      {
        "type": "oprof",
        "label": "vscodetool (Odoo with the debugger)",
        "languages": [
          "python"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "database": {
                "type": "string",
                "description": "Database to run. Asked at each start when not set."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra odoo-bin arguments."
              },
              "port": {
                "type": "number",
                "description": "HTTP port. Default: the port in the oprof.odoo.url setting, or the next free one."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "oprof",
            "request": "launch",
            "name": "vscodetool: Run Odoo"
          }
        ],
        "configurationSnippets": [
          {
            "label": "vscodetool: Run Odoo",
            "description": "Odoo with the vscodetool addon, under the Python debugger: live breakpoints, marked runs profiled and replayable",
            "body": {
              "type": "oprof",
              "request": "launch",
              "name": "vscodetool: Run Odoo"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "vscodetool",
      "properties": {
        "oprof.odoo.url": {
          "type": "string",
          "default": "http://127.0.0.1:8069",
          "description": "Where vscodetool's Odoo server listens: only its port is used (the next free one if taken); it always binds 127.0.0.1."
        },
        "oprof.odoo.database": {
          "type": "string",
          "default": "",
          "description": "Database used by the recorded server and the Runs view."
        },
        "oprof.python": {
          "type": "string",
          "default": "",
          "description": "Python of your Odoo venv (3.12+)."
        },
        "oprof.odooSource": {
          "type": "string",
          "default": "",
          "description": "Odoo community checkout (the folder with odoo-bin)."
        },
        "oprof.addonsPath": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Addons paths, in order. The vscodetool addon folder is added automatically."
        },
        "oprof.server.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra odoo-bin arguments for the recorded server."
        },
        "oprof.collectors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "sql",
            "traces_async",
            "oprof"
          ],
          "description": "Profiler collectors for marked runs. 'oprof' (vscodetool's collector) records caches and every call; 'traces_sync' is very large."
        },
        "oprof.cron.maxBatches": {
          "type": "number",
          "default": 0,
          "description": "Batches to record for a cron run (0 = all)."
        },
        "oprof.recordCalls": {
          "type": "boolean",
          "default": true,
          "description": "Record every Python call of a marked run (exact call stack and speedscope). Makes marked requests about 5-8 times slower; turn off for SQL and caches only."
        },
        "oprof.showProfilerFrames": {
          "type": "boolean",
          "default": false,
          "description": "Show the profiler's own frames (vscodetool's hooks, Odoo's profiler.py) in the views. Off: hooks are removed and their time goes to the caller (a query's time to Cursor.execute), and the profiler's bookkeeping shows as one profiler overhead frame."
        },
        "oprof.hideMissingCode": {
          "type": "boolean",
          "default": false,
          "description": "Leave out of the views the frames whose code isn't on this machine (e.g. a customer's modules, in a profile made on Odoo.sh): their callees and time go to their caller. Profiles made elsewhere are matched to your Odoo checkout and addons paths by the end of their file paths."
        },
        "oprof.retentionDays": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "description": "Delete vscodetool runs (with their profile and recording) and Odoo profiler entries older than this many days, in the databases of the side bar (checked once a day per database). 0: keep everything."
        }
      }
    },
    "colors": [
      {
        "id": "oprof.speedscopeIcon",
        "description": "Speedscope icon in the vscodetool side bar.",
        "defaults": {
          "dark": "#ffb86c",
          "light": "#d9822b",
          "highContrast": "#ffb86c",
          "highContrastLight": "#b35c00"
        }
      },
      {
        "id": "oprof.debugIcon",
        "description": "Debug actions in the vscodetool side bar (a green distinct from the run icons').",
        "defaults": {
          "dark": "#4ec9b0",
          "light": "#13836b",
          "highContrast": "#4ec9b0",
          "highContrastLight": "#0f6b57"
        }
      },
      {
        "id": "oprof.groupIcon",
        "description": "Recording sessions in the vscodetool side bar.",
        "defaults": {
          "dark": "#f48771",
          "light": "#c4314b",
          "highContrast": "#f48771",
          "highContrastLight": "#b5200d"
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-tests.mjs",
    "package": "scripts/package.sh"
  },
