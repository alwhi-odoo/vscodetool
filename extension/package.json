          "group": "2_code@1"
        },
        {
          "command": "oprof.deleteRun",
          "when": "view == oprof.runs && viewItem =~ /oprofRun odoo/",
          "group": "inline@9"
        },
        {
          "command": "oprof.deleteAllRuns",
          "when": "view == oprof.runs && viewItem == database",
          "group": "inline@9"
