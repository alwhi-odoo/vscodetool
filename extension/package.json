        },
        {
          "command": "oprof.renameGroup",
          "when": "view == oprof.runs && viewItem == oprofGroup",
          "group": "8_edit@1"
        },
        {
          "command": "oprof.deleteGroup",
          "when": "view == oprof.runs && viewItem == oprofGroup",
