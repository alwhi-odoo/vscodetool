          "group": "inline@2"
        },
        {
          "command": "oprof.openCallStack",
          "when": "view == oprof.runs && viewItem =~ /oprofRun/",
          "group": "inline@3"
        },
        {
          "command": "oprof.debugRun",
          "when": "view == oprof.runs && viewItem =~ /replayable/",
          "group": "1_open@1"
        },
        {
          "command": "oprof.openProfile",
          "when": "view == oprof.runs && viewItem =~ /oprofRun/",
          "group": "1_open@2"
        },
        {
          "command": "oprof.openSpeedscope",
          "when": "view == oprof.runs && viewItem =~ /oprofRun/",
