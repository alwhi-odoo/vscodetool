{
  "name": "oprof",
  "displayName": "vscodetool: Odoo profiler and replay debugger",
  "description": "Odoo profiler data, speedscope, call stack and cache views, and the VS Code debugger on recorded Odoo requests (replayed inside your Odoo server).",
  "version": "0.1.47",
  "publisher": "alwhi",
  "license": "LGPL-3.0-only",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebugResolve:oprof",
    "onCustomEditor:oprof.speedscope"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "oprof",
          "title": "vscodetool",
          "icon": "media/oprof.svg"
        }
      ]
    },
    "views": {
      "oprof": [
        {
          "id": "oprof.runs",
          "name": "Runs",
          "icon": "media/oprof.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "oprof.runs",
        "contents": "Start Odoo (under the debugger), then mark a request or a cron run. Marked requests are profiled and recorded, so they can be replayed to your breakpoints.\n[Start Odoo](command:oprof.startServer)\n[Set up (Odoo checkout, venv)](command:oprof.setup)\n[Open a profile file…](command:oprof.openFile)"
      }
    ],
    "commands": [
      {
        "command": "oprof.setup",
        "title": "Set up (Odoo checkout, venv, database)",
        "category": "vscodetool"
      },
      {
        "command": "oprof.startServer",
        "title": "Start Odoo (with the debugger)",
        "category": "vscodetool",
        "icon": "$(record)"
      },
      {
        "command": "oprof.stopServer",
        "title": "Stop Odoo",
        "category": "vscodetool",
        "icon": "$(debug-stop)"
      },
      {
        "command": "oprof.recordNextRequest",
        "title": "Record next request",
        "category": "vscodetool",
        "icon": "$(circle-large-filled)"
      },
      {
        "command": "oprof.recordUntilStopped",
        "title": "Record every request until stopped",
        "category": "vscodetool"
      },
      {
        "command": "oprof.stopMarking",
        "title": "Stop recording requests",
        "category": "vscodetool"
      },
      {
        "command": "oprof.recordCron",
        "title": "Record cron…",
        "category": "vscodetool",
        "enablement": "oprof.serverRunning"
      },
      {
        "command": "oprof.refreshRuns",
        "title": "Refresh",
        "category": "vscodetool",
        "icon": "$(refresh)"
      },
      {
        "command": "oprof.openFile",
        "title": "Open profile file…",
        "category": "vscodetool"
      },
      {
        "command": "oprof.setSourceVersion",
        "title": "Choose Odoo version…",
        "category": "vscodetool",
        "icon": "$(versions)"
      },
      {
        "command": "oprof.openProfile",
        "title": "Show profile",
        "category": "vscodetool",
        "icon": "$(dashboard)"
      },
      {
        "command": "oprof.openSpeedscope",
        "title": "Show speedscope",
        "category": "vscodetool",
        "icon": "$(flame)"
      },
      {
        "command": "oprof.openCallStack",
        "title": "Show call stack",
        "category": "vscodetool",
        "icon": "$(list-tree)"
      },
      {
        "command": "oprof.openCache",
        "title": "Show caches",
        "category": "vscodetool",
        "icon": "$(database)"
      },
      {
        "command": "oprof.debugRun",
        "title": "Debug this run (replay)",
        "category": "vscodetool",
        "icon": "$(debug-alt)"
      },
      {
        "command": "oprof.debugRunFromStart",
        "title": "Debug this run from the start (replay)",
        "category": "vscodetool",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "oprof.renameRun",
        "title": "Rename…",
        "category": "vscodetool",
        "icon": "$(edit)"
      },
      {
        "command": "oprof.deleteRun",
        "title": "Delete run",
        "category": "vscodetool",
        "icon": "$(trash)"
      },
      {
        "command": "oprof.deleteAllRuns",
        "title": "Delete all runs",
        "category": "vscodetool",
        "icon": "$(trash)"
      },
      {
        "command": "oprof.openRecords",
        "title": "Show record trace",
        "category": "vscodetool",
        "icon": "$(history)"
      },
      {
        "command": "oprof.openGroupRecords",
        "title": "Show record trace of the session",
        "category": "vscodetool",
        "icon": "$(history)"
      },
      {
        "command": "oprof.renameGroup",
        "title": "Rename…",
        "category": "vscodetool",
        "icon": "$(edit)"
      },
      {
        "command": "oprof.deleteGroup",
        "title": "Delete session",
        "category": "vscodetool",
        "icon": "$(trash)"
      },
      {
        "command": "oprof.fetchProfiles",
        "title": "Fetch profiles (Odoo's profiler, any database)",
        "category": "vscodetool",
        "icon": "$(cloud-download)"
      },
      {
        "command": "oprof.hideProfileDatabase",
        "title": "Hide this database",
        "category": "vscodetool",
        "icon": "$(eye-closed)"
      },
      {
        "command": "oprof.deleteOdooProfiles",
        "title": "Delete",
        "category": "vscodetool",
        "icon": "$(trash)"
      },
      {
        "command": "oprof.showCustomCode",
        "title": "Show custom code (server actions, crons, computes)…",
        "category": "vscodetool",
        "icon": "$(code)"
      },
      {
        "command": "oprof.searchRuns",
        "title": "Search runs and profiles…",
        "category": "vscodetool",
        "icon": "$(search)"
      },
      {
        "command": "oprof.openOprofFile",
        "title": "Open recording or profile file…",
        "category": "vscodetool",
        "icon": "$(folder-opened)"
      },
      {
        "command": "oprof.openSpeedscopeFile",
        "title": "Open speedscope file…",
        "category": "vscodetool",
        "icon": "$(flame)"
      },
      {
        "command": "oprof.debugGroup",
        "title": "Debug the recording session (every request, in order)",
        "category": "vscodetool",
        "icon": "$(debug-alt)"
      },
      {
        "command": "oprof.debugGroupFromStart",
        "title": "Debug the recording session from the start of each request",
        "category": "vscodetool",
        "icon": "$(debug-step-into)"
      },
      {
        "command": "oprof.importRecording",
        "title": "Import a recording into a database (to replay it)…",
        "category": "vscodetool",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "oprof.openDbGraph",
        "title": "DB record graph…",
        "category": "vscodetool",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "oprof.recordNextRequest",
          "when": "view == oprof.runs",
          "group": "navigation@1"
        },
        {
          "command": "oprof.startServer",
          "when": "view == oprof.runs && !oprof.serverRunning",
          "group": "navigation@2"
        },
        {
          "command": "oprof.stopServer",
          "when": "view == oprof.runs && oprof.serverRunning",
          "group": "navigation@2"
        },
        {
          "command": "oprof.refreshRuns",
          "when": "view == oprof.runs",
          "group": "navigation@3"
        },
        {
          "command": "oprof.recordUntilStopped",
          "when": "view == oprof.runs",
          "group": "1_record"
        },
        {
          "command": "oprof.stopMarking",
          "when": "view == oprof.runs",
          "group": "1_record"
        },
        {
          "command": "oprof.recordCron",
          "when": "view == oprof.runs",
          "group": "1_record"
        },
        {
